# One account per staff member so creations and edits can be attributed.
# Example: {"mark":{"displayName":"Mark","passwordHash":"64-char-sha256"},"mariel":{"displayName":"Mariel","passwordHash":"64-char-sha256"}}
OMD_STAFF_USERS_JSON={}
# Optional temporary fallback for the earlier shared-login configuration.
OMD_LOGIN_USERNAME=
OMD_LOGIN_PASSWORD_SHA256=
# Use a unique production value with at least 32 random characters.
OMD_SESSION_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
